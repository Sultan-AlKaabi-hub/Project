PORT=3000
NODE_ENV=production
PUBLIC_ORIGIN=https://rasid-904v.onrender.com
# Set this to your actual persistent mount. Never commit the database.
RASID_DATA_DIR=/var/data/rasid
ADMIN_EMAIL=
ANTHROPIC_API_KEY=
RASID_MODEL=claude-opus-5
PRIVACY_OPERATOR=
PRIVACY_CONTACT=
HOSTING_REGION=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# Free NewsAPI keys are local-development only. Never commit real keys.
NEWSAPI_KEY=
NEWSAPI_PRODUCTION_ALLOWED=false
# Optional independent model for learner agents
RASID_AGENT_MODEL=

# Free course/device mode is default. Hosted paid generation requires explicit opt-in.
RASID_AGENT_PROVIDER=local

# Optional deployment secret: scrypt hash for permanent owner bootstrap; never commit its value.
RASID_OWNER_PIN_HASH=

# Dedicated free Supabase project; run migrations/001-supabase-state.sql first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional Cloudflare Turnstile. Set BOTH keys; secret stays server-only.
# Configure the site's hostname in Cloudflare. Missing keys mean CAPTCHA is not active.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional SMS OTP provider (Twilio Verify; delivery may incur charges).
# Email OTP uses the existing SMTP_* settings above.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
